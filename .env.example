# =============================================================
# Agentic AI Smart Waste Collection & Recycling Optimization System
# Environment Template (.env.example)
# =============================================================

ENVIRONMENT=development
DEMO_MODE=true

# Database — SQLite for local dev; swap for PostgreSQL / PostGIS in production
# SQLite: sqlite:///./smart_waste.db
# PostgreSQL: postgresql+psycopg2://waste_user:waste_pass@localhost:5432/smart_waste_db
DATABASE_URL=sqlite:///./smart_waste.db

# LLM Provider: gemini | openai | claude | deterministic
LLM_PROVIDER=gemini

# Add your API key to enable LLM features; leave blank to use deterministic fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# API Settings
API_V1_STR=/api
PROJECT_NAME=Smart Waste Collection & Recycling Optimization System
VERSION=1.0.0

# CORS — comma-separated or JSON list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# Report storage directory (relative to project root)
REPORT_DIR=data/reports
